extends "res://tests/phase_5b_smoke.gd"
func run() -> void:
	var state := ProfessionRunState.new()
	state.begin(&"MOJIN")
	check(state.tokens() == [&"MOJIN"] and state.active_id == &"MOJIN","Chosen initial token independent of relic/antique inventory")
	check(state.spend(&"MOJIN:SCAN",1) and not state.spend(&"MOJIN:SCAN",1),"Single-use ledger rejects duplicate consumption")
	check(state.search(&"F1:R:BANSHAN",&"BANSHAN",{"name":"无名前辈"}),"Search adds a separate profession token and identity")
	check(not state.search(&"F1:R:BANSHAN",&"BANSHAN",{}),"Same corpse searched exactly once")
	check(state.equip_without_signal(&"BANSHAN") and state.equip_without_signal(&"MOJIN") and state.used(&"MOJIN:SCAN") == 1,"Switch never resets consumed ability")
	check(state.search(&"F2:R:BANSHAN",&"BANSHAN",{}) and state.tokens().size()==2,"Duplicate token does not stack")
	var copy := state.tokens(); copy.clear(); check(state.tokens().size()==2,"Returned token array cannot mutate state")
	var registry := SiteRegistry.load_default()
	var choice := ExpeditionSelection.capture(registry.site(&"DEFAULT_TOMB"),52,1,0,&"MOJIN")
	var snapshot := choice.copy_for_departure()
	check(snapshot.initial_profession_id==&"MOJIN" and snapshot.seed_value==choice.seed_value and snapshot!=choice,"Snapshot retains class and old deterministic Seed")
	check(ExpeditionSelection.capture(registry.site(&"DEFAULT_TOMB"),52,1,0,&"INVALID")==null,"Unknown initial class rejected")
	state.end(); check(state.tokens().is_empty() and state.active_id==&"NONE" and state.consumption_ledger().is_empty(),"End clears only run profession state")
	state.begin(&"NONE"); check(state.tokens().is_empty() and state.active_id==&"NONE","Next departure without faction gives no token")
	var layout := TombFloorGenerator.generate(522269330,1,registry.site(&"DEFAULT_TOMB").tomb_definition)
	var signature := layout.signature()
	var plan := ProfessionCorpsePlan.build(522269330,1,layout)
	check(plan.assigned.size()==4 and layout.signature()==signature,"Four predecessor corpses without topology changes")
	check(plan.assigned==ProfessionCorpsePlan.build(522269330,1,layout).assigned,"Independent corpse stream deterministic")
	var inventory := AntiqueInventory.new(10)
	var coin := MuseumState.POOL.find_by_id(&"republic_silver_coin")
	for index in range(10): check(inventory.add(coin),"Ten slots valid in Xieling capacity")
	inventory.capacity=8
	check(inventory.items().size()==10 and not inventory.can_add(coin),"Over-capacity retains items but blocks pickups")
	var next := AntiqueInventory.new(8)
	check(next.restore_carry(inventory.items()) and next.items().size()==10,"Cross-floor carry preserves overload items")
	for seed_value in range(100):
		var generated := TombFloorGenerator.generate(seed_value,1,registry.site(&"DEFAULT_TOMB").tomb_definition)
		var topology := generated.signature()
		var boss := BossRunPlan.build(seed_value,registry.site(&"DEFAULT_TOMB").tomb_definition).signature()
		var relic := RelicRewardPlan.build(seed_value,5,RelicRewardService.PRODUCTION_POOL).signature()
		var antique := MuseumState.POOL.pick(seed_value,1,&"ROOM_TEST").id
		var corpses := ProfessionCorpsePlan.build(seed_value,1,generated)
		check(corpses.assigned.values().size()==4 and ProfessionRunState.IDS.all(func(id): return id in corpses.assigned.values()),"Production first floor contains all factions Seed%d"%seed_value)
		check(corpses.assigned==ProfessionCorpsePlan.build(seed_value,1,generated).assigned and topology==generated.signature(),"Corpse stream stable and topology untouched Seed%d"%seed_value)
		check(boss==BossRunPlan.build(seed_value,registry.site(&"DEFAULT_TOMB").tomb_definition).signature() and relic==RelicRewardPlan.build(seed_value,5,RelicRewardService.PRODUCTION_POOL).signature() and antique==MuseumState.POOL.pick(seed_value,1,&"ROOM_TEST").id,"Independent reward/Boss/antique signatures Seed%d"%seed_value)
	print("[Phase13A model] %d checks, %d failures" % [checks,failures]); quit(0 if failures==0 else 1)
